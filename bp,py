import math
import matplotlib.pyplot as plt
from matplotlib.patches import Polygon, Arc

plt.rcParams["mathtext.fontset"] = "cm"
COLORS = ["black"] * 10          # بدون تلوين: كل الحواف بالأسود


def stadium(p, q, r, steps=40):
    """شكل مستطيل بطرفين دائريين يحيط بالقطعة pq."""
    ang = math.atan2(q[1] - p[1], q[0] - p[0])
    pts = []
    for cx, cy, a0 in [(q[0], q[1], ang - math.pi / 2), (p[0], p[1], ang + math.pi / 2)]:
        for t in range(steps + 1):
            a = a0 + math.pi * t / steps
            pts.append((cx + r * math.cos(a), cy + r * math.sin(a)))
    return pts


def lerp(p, q, t):
    return (p[0] + t * (q[0] - p[0]), p[1] + t * (q[1] - p[1]))


def polygon_points(n, R=2.3):
    """رؤوس مضلع منتظم، يبدأ من الأعلى ويدور مع عقارب الساعة."""
    return [(R * math.cos(math.pi / 2 - 2 * math.pi * i / n),
             R * math.sin(math.pi / 2 - 2 * math.pi * i / n)) for i in range(n)]


def draw_edge(ax, p, q, m, color, label, general=False):
    """حافة واحدة: الرأسان المشتركان p, q و m رأساً داخلياً (m = k-2)."""
    ax.add_patch(Polygon(stadium(p, q, 0.32), closed=True, fill=False,
                         edgecolor=color, lw=1.2))
    if general:                                         # 2 رأس، ثم ⋯، ثم الأخير
        ts = [0.25, 0.40, 0.78]
        for t in (0.55, 0.59, 0.63):
            x, y = lerp(p, q, t)
            ax.plot(x, y, "o", color="black", markersize=2.3, zorder=6)
    else:
        ts = [i / (m + 1) for i in range(1, m + 1)]
    for t in ts:
        x, y = lerp(p, q, t)
        ax.plot(x, y, "o", color="white", mec="black", markersize=8, zorder=5)
    # اسم الحافة خارج المضلع
    mx, my = lerp(p, q, 0.5)
    d = math.hypot(mx, my)
    ax.text(mx + 0.65 * mx / d, my + 0.65 * my / d, label, color=color,
            fontsize=16, ha="center", va="center")


def label_vertex(ax, x, y, name):
    ax.plot(x, y, "o", color="black", markersize=9, zorder=6)
    d = math.hypot(x, y)
    ax.text(x + 0.55 * x / d, y + 0.55 * y / d, name, fontsize=16,
            ha="center", va="center")


def draw_loose_cycle(ax, n, k):
    """C_n^(k) لقيم محددة لـ n و k."""
    P = polygon_points(n)
    for i in range(n):
        draw_edge(ax, P[i], P[(i + 1) % n], k - 2, COLORS[i % 10], rf"$e_{{{i + 1}}}$")
    for i, (x, y) in enumerate(P):
        label_vertex(ax, x, y, rf"$v_{{{i + 1}}}$")


def draw_general(ax):
    """C_n^(k) العام: نرسم بعض الحواف، والباقي يُختصر بقوس متقطع و ⋯."""
    P = polygon_points(7)
    names = [r"$v_1$", r"$v_2$", r"$v_3$", r"$v_4$", None, r"$v_{n-1}$", r"$v_n$"]
    edges = [(0, 1, r"$e_1$"), (1, 2, r"$e_2$"), (2, 3, r"$e_3$"),
             (5, 6, r"$e_{n-1}$"), (6, 0, r"$e_n$")]
    for c, (i, j, lab) in enumerate(edges):
        draw_edge(ax, P[i], P[j], 0, COLORS[c], lab, general=True)
    # الجزء المحذوف بين v4 و v_{n-1}
    a4 = math.degrees(math.atan2(P[3][1], P[3][0]))
    a6 = math.degrees(math.atan2(P[5][1], P[5][0]))
    ax.add_patch(Arc((0, 0), 4.6, 4.6, theta1=a6 + 8, theta2=a4 - 8,
                     color="black", ls="--", lw=1.0))
    ax.text(0, -1.9, r"$\cdots$", ha="center", va="center", fontsize=22)
    for (x, y), name in zip(P, names):
        if name:
            label_vertex(ax, x, y, name)


fig, axes = plt.subplots(1, 3, figsize=(17, 6.5))

draw_loose_cycle(axes[0], 4, 3)
axes[0].set_title(r"(a) $C_4^{(3)}$", fontsize=15)
axes[0].text(0, -3.6, r"$|V|=4\cdot2=8,\ |E|=4$", ha="center", fontsize=14)

draw_loose_cycle(axes[1], 5, 4)
axes[1].set_title(r"(b) $C_5^{(4)}$", fontsize=15)
axes[1].text(0, -3.6, r"$|V|=5\cdot3=15,\ |E|=5$", ha="center", fontsize=14)

draw_general(axes[2])
axes[2].set_title(r"(c) $C_n^{(k)}$: each edge has $k-2$ inner vertices", fontsize=15)
axes[2].text(0, -3.6, r"$|V|=n(k-1),\ |E|=n$", ha="center", fontsize=14)

for ax in axes:
    ax.set_xlim(-3.6, 3.6)
    ax.set_ylim(-4.0, 3.5)
    ax.set_aspect("equal")
    ax.axis("off")

fig.text(0.5, -0.01, r"$e_i=\{v_i,\,u_{i,1},\ldots,u_{i,k-2},\,v_{i+1}\}$ (indices mod $n$):"
         r"  consecutive edges share exactly one vertex, non-consecutive edges are disjoint",
         ha="center", fontsize=14)

plt.tight_layout()
plt.savefig("Cn_loose_cycle.png", dpi=300, bbox_inches="tight")
plt.savefig("Cn_loose_cycle.pdf", bbox_inches="tight")
plt.show()